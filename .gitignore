# ============================================================================
#  .gitignore —— Minidayz-WebRTC
#  目标：只提交"源码 + 工程配置 + web 资源"，不提交依赖与构建产物
#       （推到 GitHub 走云构建时，体积从 1GB+ 降到 ~60MB）
# ============================================================================

# 依赖
node_modules/
.pnpm-store/

# Android 构建产物 / 本机配置
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/capacitor-cordova-android-plugins/src/main/libs/
*.apk
*.aab

# iOS 构建产物 / 依赖
ios/App/Pods/
ios/App/build/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/Podfile.lock
ios/App/output/
*.ipa
*.xcarchive

# ---- 单机版（sp/）构建线 ----
# 构建产物：由 sp/scripts/prepare.ps1 生成，不入库
sp/ios/App/App/public/
sp/ios/App/App/capacitor.config.json
sp/ios/App/Pods/
sp/ios/App/Podfile.lock
sp/ios/App/App.xcworkspace/
sp/ios/App/App.xcworkspace/xcuserdata/
sp/ios/App/App.xcodeproj/xcuserdata/
sp/ios/App/node_modules/
# ⚠️ sp/web/ 必须提交（那是 CI 唯一能看到的游戏本体来源，见 sp/scripts/sync-game.ps1）

# 打包好的成品（体积大，单独分发，不入库）
dist/

# 工具链日志
tools/last-build.log

# 编辑器 / 系统
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# AI 助手的工作目录（记忆、验证截图等，属于本机数据，不入库）
.workbuddy-ai/
